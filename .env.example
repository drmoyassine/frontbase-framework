# Frontbase CMS — local Docker self-host environment (docker-compose.yml).
# Copy to .env (gitignored) and fill in. Everything is optional — but set
# SESSION_SECRET to keep the at-rest cipher OUT of the database.

# --- recommended (auto-generated + persisted in the state DB when unset) ----
# Signs session cookies AND derives the at-rest cipher for secret variables.
# Kept COMMENTED so the Cloudflare Deploy Button doesn't prompt for it —
# uncomment locally (Docker) if you want an explicit one.
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ROTATION CAVEAT: changing it invalidates every session AND the at-rest
# encryption of stored secret variables — see docs/guides/self-host-docker.md.
#SESSION_SECRET=

# --- first administrator (seeded at boot when set; idempotent — existing
#  users are never reseeded). The Cloudflare Deploy Button prompts for these
#  two; fill them there (or later in the dashboard) to skip the setup flow.
#  Omit entirely to use the browser setup flow instead (/setup + SETUP_TOKEN).
ADMIN_EMAIL=
ADMIN_PASSWORD=
#ADMIN_ROLE=master_admin

# --- browser setup flow (optional, alternative to ADMIN_* seeds) ------------
#SETUP_TOKEN=some-long-random-string
#SETUP_EXPIRES_AT=2026-01-01T01:00:00.000Z

# --- storage ----------------------------------------------------------------
# App database: sqlite file on the named volume. (Generic postgres/mysql as the
# APP database is a documented unclosable gap — sqlite is the design.)
#APP_DB_URL=file:/data/app.db
# Host port to map (container always listens on 8787):
#FRONTBASE_PORT=8787

# --- S3-compatible file storage (optional) ----------------------------------
#STORAGE_ACCESS_KEY_ID=
#STORAGE_SECRET_ACCESS_KEY=
#STORAGE_ENDPOINT=
#STORAGE_REGION=
