          {
            "id": "ag-problem-section",
            "type": "FeatureSection",
            "props": {
              "title": "The Cloud Doesn't Reaches The Field",
              "subtitle": "Precision farming generates terabytes of data. Sending it all to AWS over 3G is impossible.",
              "headerAlignment": "center",
              "columns": 3,
              "iconSize": "lg",
              "iconAlignment": "left",
              "textAlignment": "left",
              "iconColor": "hsl(0 84% 60%)",
              "textColor": "hsl(var(--muted-foreground))",
              "cardBackground": "hsl(var(--card))",
              "sectionBackground": "var(--background)",
              "enableSwipeOnMobile": false,
              "anchor": "the-problem",
              "features": [
                {
                  "id": "ag-prob-1",
                  "icon": "WifiOff",
                  "title": "Cellular Dead Zones",
                  "description": "Only 25% of U.S. farmland has reliable cellular coverage. Cloud-native AgTech applications frequently timeout, leaving expensive automated machinery stalled mid-field while waiting for a server in Virginia."
                },
                {
                  "id": "ag-prob-2",
                  "icon": "Droplet",
                  "title": "Irrigation Failures",
                  "description": "When a centralized weather API or cloud orchestrator goes down, smart irrigation systems default to off. Crop yields drop instantly. Water management requires local decision-making."
                },
                {
                  "id": "ag-prob-3",
                  "icon": "HardDrive",
                  "title": "Bandwidth Choke Points",
                  "description": "A single drone mapping flight generates gigabytes of multispectral imagery. Uploading this over rural internet takes days. Real-time weed detection and NDVI analysis is impossible with cloud latency."
                }
              ]
            },
            "styles": {},
            "children": []
          },
          {
            "id": "ag-solution-section",
            "type": "FeatureSection",
            "props": {
              "title": "Autonomous Edge Hubs",
              "subtitle": "Deploy Frontbase to an industrial PC in the barn. Process everything locally.",
              "headerAlignment": "center",
              "columns": 3,
              "iconSize": "lg",
              "iconAlignment": "center",
              "textAlignment": "center",
              "iconColor": "hsl(142 71% 45%)",
              "textColor": "hsl(var(--muted-foreground))",
              "cardBackground": "hsl(var(--card))",
              "sectionBackground": "var(--muted)",
              "enableSwipeOnMobile": false,
              "anchor": "the-solution",
              "features": [
                {
                  "id": "ag-sol-1",
                  "icon": "Tractor",
                  "title": "Fleet Telemetry at the Barn",
                  "description": "Tractors sync their telemetry to the local edge node via LoRaWAN or farm WiFi. Dashboards load instantly for farm managers — no internet required."
                },
                {
                  "id": "ag-sol-2",
                  "icon": "Cpu",
                  "title": "Local AI & Computer Vision",
                  "description": "Process drone imagery directly on the edge node. Detect weeds, blight, and pest damage locally, sending only a 10KB alert payload to the central cloud."
                },
                {
                  "id": "ag-sol-3",
                  "icon": "Database",
                  "title": "Offline-First Dashboards",
                  "description": "Staff in the field use tablets connected to the local edge network. They can log maintenance, update crop status, and check soil moisture with zero lag."
                }
              ]
            },
