          {
            "id": "gv-problem-section",
            "type": "FeatureSection",
            "props": {
              "title": "The Municipal Ransomware Epidemic",
              "subtitle": "Centralized city IT is the #1 target. When it falls, everything — from 911 to water billing — goes with it.",
              "headerAlignment": "center",
              "columns": 2,
              "iconSize": "lg",
              "iconAlignment": "left",
              "textAlignment": "left",
              "iconColor": "hsl(0 84% 60%)",
              "textColor": "hsl(var(--muted-foreground))",
              "cardBackground": "hsl(var(--card))",
              "sectionBackground": "var(--background)",
              "enableSwipeOnMobile": false,
              "anchor": "the-problem",
              "features": [
                {
                  "id": "gv-prob-1",
                  "icon": "AlertOctagon",
                  "title": "City of Atlanta (March 2018)",
                  "description": "SamSam ransomware crippled centralized city IT. Utility payments, parking, and court services knocked offline. Employees reverted to pen and paper for weeks. Police dashcam footage permanently destroyed. Total cost: $17 million — for a $51,000 ransom they refused to pay."
                },
                {
                  "id": "gv-prob-2",
                  "icon": "Lock",
                  "title": "City of Baltimore (May 2019)",
                  "description": "RobbinHood ransomware exploited outdated, centralized systems. City email, phone lines, and online billing offline for months. Real estate transactions halted citywide. Employees used personal Gmail for official business. Total cost: $18.2 million."
                },
                {
                  "id": "gv-prob-3",
                  "icon": "ShieldAlert",
                  "title": "City of Dallas (May 2023)",
                  "description": "Royal ransomware group infiltrated systems a full month before encrypting. Police and Fire dispatch (CAD) systems disrupted. 1.169 TB of data exfiltrated. 30,000+ individuals' PII compromised including SSNs and health records. $8.5M budget for recovery plus $4M for new detection systems."
                },
                {
                  "id": "gv-prob-4",
                  "icon": "Phone",
                  "title": "The 911 Fragility Crisis",
                  "description": "90% of US emergency communication centers experienced at least one outage in the past year. Many still run on decades-old analog systems. The CrowdStrike July 2024 incident forced 911 dispatch centers across multiple states to revert to paper-based manual dispatch. NG911 modernization requires $15+ billion."
                }
              ]
            },
            "styles": {},
            "children": []
          },
          {
            "id": "gv-solution-section",
            "type": "FeatureSection",
            "props": {
              "title": "Decentralized Municipal Operations",
              "subtitle": "Every fire station, utility plant, and satellite office runs its own autonomous edge node. If City Hall falls, your city keeps running.",
              "headerAlignment": "center",
              "columns": 2,
              "iconSize": "lg",
              "iconAlignment": "center",
              "textAlignment": "center",
              "iconColor": "hsl(142 71% 45%)",
              "textColor": "hsl(var(--muted-foreground))",
              "cardBackground": "hsl(var(--card))",
              "sectionBackground": "var(--muted)",
              "enableSwipeOnMobile": false,
              "anchor": "the-solution",
              "features": [
                {
                  "id": "gv-sol-1",
                  "icon": "Building",
                  "title": "Departmental Autonomy",
                  "description": "Fire stations, utility plants, and satellite offices run their own edge node with independent SQLite databases. If City Hall's datacenter is compromised, local services continue 100% independently — no shared infrastructure to cascade through."
                },
                {
                  "id": "gv-sol-2",
                  "icon": "Shield",
                  "title": "Ransomware Blast Containment",
                  "description": "Isolated databases per department. A breach in the billing system can't cascade to police dispatch or water treatment. Each edge node is a self-contained blast radius — just like physical departments should be."
                },
                {
                  "id": "gv-sol-3",
                  "icon": "Phone",
                  "title": "Zero-Dependency Emergency Backups",
                  "description": "Dispatch dashboards deployed to edge run without central CAD servers. If the central system goes down — whether from ransomware or a CrowdStrike-style update — local dispatchers maintain full operational capability."
                },
                {
                  "id": "gv-sol-4",
                  "icon": "FileCode",
                  "title": "Immutable Citizen Portals",
                  "description": "Published portals are static, pre-compiled bundles with zero server-side code execution surface for attackers. No dynamic runtime to exploit. No database injection points. Rollback to a clean version is instant."
                }
              ]
            },
