          {
            "id": "env-problem-section",
            "type": "FeatureSection",
            "props": {
              "title": "You Can't Stop What You Can't See",
              "subtitle": "Critical environmental data is useless if it's trapped in a disconnected sensor.",
              "headerAlignment": "center",
              "columns": 3,
              "iconSize": "lg",
              "iconAlignment": "left",
              "textAlignment": "left",
              "iconColor": "hsl(0 84% 60%)",
              "textColor": "hsl(var(--muted-foreground))",
              "cardBackground": "hsl(var(--card))",
              "sectionBackground": "var(--background)",
              "enableSwipeOnMobile": false,
              "anchor": "the-problem",
              "features": [
                {
                  "id": "env-prob-1",
                  "icon": "Flame",
                  "title": "Wildfire Detection Delays",
                  "description": "Standard optical sensors stream gigabytes of raw video to the cloud for smoke detection. Over slow satellite links, imagery gets compressed or dropped, delaying response times when every minute counts."
                },
                {
                  "id": "env-prob-2",
                  "icon": "Waves",
                  "title": "Flood Sensor Washouts",
                  "description": "During severe storms, cell networks are the first infrastructure to fail. River gauges reliant on constant 5G connectivity go dark precisely when municipalities need flood data the most."
                },
                {
                  "id": "env-prob-3",
                  "icon": "BatteryWarning",
                  "title": "Power & Bandwidth Drain",
                  "description": "Constantly pinging a central server drains battery life on solar-powered wilderness hardware. Devices die months before their scheduled maintenance, leaving massive blind spots."
                }
              ]
            },
            "styles": {},
            "children": []
          },
          {
            "id": "env-solution-section",
            "type": "FeatureSection",
            "props": {
              "title": "Edge Intelligence in the Wild",
              "subtitle": "Process data locally. Transmit only the emergencies.",
              "headerAlignment": "center",
              "columns": 3,
              "iconSize": "lg",
              "iconAlignment": "center",
              "textAlignment": "center",
              "iconColor": "hsl(142 71% 45%)",
              "textColor": "hsl(var(--muted-foreground))",
              "cardBackground": "hsl(var(--card))",
              "sectionBackground": "var(--muted)",
              "enableSwipeOnMobile": false,
              "anchor": "the-solution",
              "features": [
                {
                  "id": "env-sol-1",
                  "icon": "Brain",
                  "title": "On-Device Anomaly ML",
                  "description": "Run AI models directly on the sensor edge. Cameras detect smoke patterns locally and only transmit a 5KB coordinate alert, rather than streaming 4K video over satellite."
                },
                {
                  "id": "env-sol-2",
                  "icon": "Database",
                  "title": "Crisis Data Buffering",
                  "description": "When storms knock out network bridges, SQLite databases on the edge continue to aggregate river levels. When the link returns, everything syncs chronologically to the cloud."
                },
                {
                  "id": "env-sol-3",
                  "icon": "BatteryCharging",
                  "title": "Optimized Transmissions",
                  "description": "Edge nodes consolidate sensor readings. Instead of 10,000 pings a day, Frontbase workflows bundle data into a single, efficient burst — extending battery life by years."
                }
              ]
            },
