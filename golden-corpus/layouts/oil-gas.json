          {
            "id": "og-problem-section",
            "type": "FeatureSection",
            "props": {
              "title": "When Centralized IT Becomes the Vulnerability",
              "subtitle": "The biggest threat to oil & gas operations isn't the wellhead — it's the cloud dependency chain behind it.",
              "headerAlignment": "center",
              "columns": 3,
              "iconSize": "lg",
              "iconAlignment": "left",
              "textAlignment": "left",
              "iconColor": "hsl(0 84% 60%)",
              "textColor": "hsl(var(--muted-foreground))",
              "cardBackground": "hsl(var(--card))",
              "sectionBackground": "var(--background)",
              "enableSwipeOnMobile": false,
              "anchor": "the-problem",
              "features": [
                {
                  "id": "og-prob-1",
                  "icon": "Lock",
                  "title": "Colonial Pipeline (May 2021)",
                  "description": "DarkSide ransomware accessed IT systems via a single VPN account without MFA. The pipeline's OT was never breached — but Colonial shut down the entire operation preemptively because IT and OT weren't isolated. 45% of East Coast fuel supply halted. 87% of DC gas stations ran dry. $4.4M ransom paid."
                },
                {
                  "id": "og-prob-2",
                  "icon": "AlertOctagon",
                  "title": "Halliburton Cyberattack (Aug 2024)",
                  "description": "A cybersecurity incident forced the oil services giant to take entire systems offline. Centralized enterprise IT became a single blast radius — disrupting operations across the company while the extent of the data breach was investigated."
                },
                {
                  "id": "og-prob-3",
                  "icon": "Satellite",
                  "title": "The VSAT Connectivity Paradox",
                  "description": "Offshore rigs depend on VSAT/LEO satellite links with ~700ms latency and routine dropouts. Every connectivity interruption blinds central command to rig telemetry. CISA repeatedly warns about internet-exposed SCADA/PLC devices — but operators need connectivity for remote monitoring."
                }
              ]
            },
            "styles": {},
            "children": []
          },
          {
            "id": "og-solution-section",
            "type": "FeatureSection",
            "props": {
              "title": "True Air-Gap Operations",
              "subtitle": "Frontbase runs entirely on local hardware. No cloud backhaul. No satellite dependency. No attack surface.",
              "headerAlignment": "center",
              "columns": 2,
              "iconSize": "lg",
              "iconAlignment": "center",
              "textAlignment": "center",
              "iconColor": "hsl(142 71% 45%)",
              "textColor": "hsl(var(--muted-foreground))",
              "cardBackground": "hsl(var(--card))",
              "sectionBackground": "var(--muted)",
              "enableSwipeOnMobile": false,
              "anchor": "the-solution",
              "features": [
                {
                  "id": "og-sol-1",
                  "icon": "WifiOff",
                  "title": "Zero-Internet Field Operations",
                  "description": "Frontbase edge bundles run on local industrial PCs with zero internet dependency. Drilling dashboards, pressure monitoring, and safety inspection UIs operate with no cloud connection at all. If Starlink drops, operations continue seamlessly."
                },
                {
                  "id": "og-sol-2",
                  "icon": "Shield",
                  "title": "IT/OT Blast Isolation",
                  "description": "Deploy separate edge instances for corporate IT dashboards vs. operational field monitoring. A ransomware event on headquarters' email server has zero blast radius on rig-side pressure gauges and safety systems."
                },
                {
                  "id": "og-sol-3",
                  "icon": "Satellite",
                  "title": "Satellite-Tolerant Sync",
                  "description": "Edge Redis queues buffer telemetry, inspection reports, and maintenance logs locally. Data syncs opportunistically during SATCOM windows — zero data loss during satellite dropout. Works with VSAT, Starlink, or field mesh networks."
                },
                {
                  "id": "og-sol-4",
                  "icon": "Undo2",
                  "title": "Immutable Field Deploys",
                  "description": "No forced remote updates to rig-side systems. Pre-compiled, tested bundles deployed manually during maintenance windows or via sneakernet. If an update breaks something, one-click rollback restores the prior version instantly."
                }
              ]
            },
