          {
            "id": "mf-problem-section",
            "type": "FeatureSection",
            "props": {
              "title": "When Centralized IT Shuts Down the Factory Floor",
              "subtitle": "Manufacturing is the #1 most targeted industry for ransomware. 47% of all manufacturing breaches in 2024 were ransomware.",
              "headerAlignment": "center",
              "columns": 3,
              "iconSize": "lg",
              "iconAlignment": "left",
              "textAlignment": "left",
              "iconColor": "hsl(0 84% 60%)",
              "textColor": "hsl(var(--muted-foreground))",
              "cardBackground": "hsl(var(--card))",
              "sectionBackground": "var(--background)",
              "enableSwipeOnMobile": false,
              "anchor": "the-problem",
              "features": [
                {
                  "id": "mf-prob-1",
                  "icon": "Lock",
                  "title": "Norsk Hydro — $75M (March 2019)",
                  "description": "LockerGoga ransomware forced the aluminum giant to shut down its global IT network and switch 35,000 employees to manual operations. Smelting plants reverted to pen-and-paper control. Total cost: $63–75 million in lost margins, production volume, and remediation."
                },
                {
                  "id": "mf-prob-2",
                  "icon": "AlertOctagon",
                  "title": "Toyota — $356M/day (2022–2023)",
                  "description": "In 2022, a cyberattack on a single supplier (Kojima Industries) forced Toyota to halt all 28 production lines across 14 plants — cutting global output by one-third. In 2023, a system 'glitch' in centralized parts ordering shut down 14 factories again. One day of lost production: ~$356M."
                },
                {
                  "id": "mf-prob-3",
                  "icon": "TrendingDown",
                  "title": "MKS Instruments — $200M+ (Feb 2023)",
                  "description": "Ransomware severely disrupted production systems at MKS Instruments, contributing to a 20% decline in quarterly revenue and losses exceeding $200 million. Earlier that year, Brunswick Corporation lost at least $85 million. Clorox lost $356 million in sales."
                }
              ]
            },
            "styles": {},
            "children": []
          },
          {
            "id": "mf-stats-section",
            "type": "FeatureSection",
            "props": {
              "title": "The Manufacturing Downtime Crisis",
              "subtitle": "The numbers don't lie — centralized IT is the factory floor's weakest link.",
              "headerAlignment": "center",
              "columns": 4,
              "iconSize": "md",
              "iconAlignment": "center",
              "textAlignment": "center",
              "iconColor": "hsl(220 80% 60%)",
              "textColor": "hsl(var(--muted-foreground))",
              "cardBackground": "hsl(var(--card))",
              "sectionBackground": "var(--muted)",
              "enableSwipeOnMobile": true,
              "features": [
                {
                  "id": "mf-stat-1",
                  "icon": "DollarSign",
                  "title": "$17,000/minute",
                  "description": "Average cost of unplanned manufacturing downtime. A 4-hour outage costs over $4 million before reputation damage."
                },
                {
                  "id": "mf-stat-2",
                  "icon": "Target",
                  "title": "#1 Target",
                  "description": "Manufacturing has been the most targeted industry for ransomware attacks for multiple consecutive years."
                },
                {
                  "id": "mf-stat-3",
                  "icon": "PieChart",
                  "title": "47% Ransomware",
                  "description": "Nearly half of all manufacturing data breaches in 2024 were ransomware — the highest proportion of any sector."
                },
                {
                  "id": "mf-stat-4",
                  "icon": "AlertTriangle",
                  "title": "$4.88M Avg Breach",
                  "description": "Global average cost of a data breach in 2024. Industrial and infrastructure breaches frequently exceed $5 million."
                }
              ]
            },
            "styles": {},
            "children": []
          },
          {
            "id": "mf-solution-section",
            "type": "FeatureSection",
            "props": {
              "title": "Plant-Level Edge Independence",
              "subtitle": "Each factory runs its own autonomous edge node. A ransomware attack on corporate HQ doesn't touch the production floor.",
              "headerAlignment": "center",
              "columns": 2,
              "iconSize": "lg",
              "iconAlignment": "center",
              "textAlignment": "center",
              "iconColor": "hsl(142 71% 45%)",
              "textColor": "hsl(var(--muted-foreground))",
              "cardBackground": "hsl(var(--card))",
              "sectionBackground": "var(--background)",
              "enableSwipeOnMobile": false,
              "anchor": "the-solution",
              "features": [
                {
                  "id": "mf-sol-1",
                  "icon": "Factory",
                  "title": "SCADA-Like Operator Panels",
                  "description": "Build real-time OEE dashboards, quality control interfaces, and operator panels visually — no code. Each panel runs on local edge hardware with its own SQLite database. Zero dependency on corporate IT or cloud."
                },
                {
                  "id": "mf-sol-2",
                  "icon": "Shield",
                  "title": "Supply Chain Blast Isolation",
                  "description": "A breach at one supplier or one plant stays contained. Isolated edge databases per facility ensure that ransomware in Plant A has zero impact on Plants B, C, and D."
                },
                {
                  "id": "mf-sol-3",
                  "icon": "Undo2",
                  "title": "Immutable Production Deploys",
                  "description": "No forced OTA updates to factory floor systems. Pre-compiled, tested bundles deployed during planned maintenance windows. If an update causes issues, one-click rollback restores the prior version instantly."
                },
                {
                  "id": "mf-sol-4",
                  "icon": "Activity",
                  "title": "Predictive Maintenance Pipelines",
                  "description": "Edge Redis queues buffer sensor telemetry locally. Run anomaly detection and predictive maintenance workflows at the plant edge — not in a distant cloud datacenter with 200ms of latency."
                }
              ]
            },
