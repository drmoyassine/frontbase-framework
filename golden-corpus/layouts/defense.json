          {
            "id": "df-problem-section",
            "type": "FeatureSection",
            "props": {
              "title": "The DDIL Problem: Centralized C2 in Contested Environments",
              "subtitle": "Denied, Degraded, Intermittent, and Limited connectivity. When the adversary controls the spectrum, cloud-dependent C2 goes blind.",
              "headerAlignment": "center",
              "columns": 3,
              "iconSize": "lg",
              "iconAlignment": "left",
              "textAlignment": "left",
              "iconColor": "hsl(0 84% 60%)",
              "textColor": "hsl(var(--muted-foreground))",
              "cardBackground": "hsl(var(--card))",
              "sectionBackground": "var(--background)",
              "enableSwipeOnMobile": false,
              "anchor": "the-problem",
              "features": [
                {
                  "id": "df-prob-1",
                  "icon": "WifiOff",
                  "title": "Electronic Warfare Jamming",
                  "description": "Contested battlefields are DDIL by design. Adversaries actively jam SATCOM, exploit EW to sever links between forward units and CONUS cloud providers. When forward C2 depends on cloud backhaul, an EW attack doesn't just disrupt comms — it blinds entire command chains."
                },
                {
                  "id": "df-prob-2",
                  "icon": "Timer",
                  "title": "High-Latency Sensor-to-Shooter Loop",
                  "description": "Drone ISR and sensor data traverses thousands of miles of satellite routing to reach centralized cloud analysis. This introduces minutes of lag in time-critical targeting decisions. In peer-to-peer combat, minutes mean lives. Edge AI inferencing eliminates this deadly delay."
                },
                {
                  "id": "df-prob-3",
                  "icon": "AlertOctagon",
                  "title": "Supply Chain Update Risk",
                  "description": "CrowdStrike-style forced updates on centralized systems represent an existential risk in military contexts. A single bad update pushed to forward-deployed C2 systems could disable an entire theater's command capability. Immutable, intentional deployments eliminate this vector."
                }
              ]
            },
            "styles": {},
            "children": []
          },
          {
            "id": "df-context-section",
            "type": "FeatureSection",
            "props": {
              "title": "Aligned with CJADC2 Priorities",
              "subtitle": "The Department of Defense is already moving toward exactly the architecture Frontbase provides.",
              "headerAlignment": "center",
              "columns": 4,
              "iconSize": "md",
              "iconAlignment": "center",
              "textAlignment": "center",
              "iconColor": "hsl(220 80% 60%)",
              "textColor": "hsl(var(--muted-foreground))",
              "cardBackground": "hsl(var(--card))",
              "sectionBackground": "var(--muted)",
              "enableSwipeOnMobile": true,
              "features": [
                {
                  "id": "df-ctx-1",
                  "icon": "WifiOff",
                  "title": "Disconnected-First",
                  "description": "Systems engineered to operate autonomously at the tactical edge for extended periods — syncing only when connectivity is restored."
                },
                {
                  "id": "df-ctx-2",
                  "icon": "ShieldCheck",
                  "title": "Zero Trust at the Edge",
                  "description": "Identity-first, segmented, continuously validated security protocols built directly into deployed edge nodes."
                },
                {
                  "id": "df-ctx-3",
                  "icon": "Blocks",
                  "title": "Modular Open Systems",
                  "description": "MOSA: field-swappable computing modules using open standards. Rapid upgrades without full system overhaul."
                },
                {
                  "id": "df-ctx-4",
                  "icon": "Server",
                  "title": "Tactical Cloudlets",
                  "description": "Micro data centers deployed to vehicles, ships, and FOBs. Full computing capability in ruggedized, portable form factors."
                }
              ]
            },
            "styles": {},
            "children": []
          },
          {
            "id": "df-solution-section",
            "type": "FeatureSection",
            "props": {
              "title": "DDIL-Native by Design",
              "subtitle": "Frontbase's edge architecture wasn't adapted for disconnected operations — it was built for them.",
              "headerAlignment": "center",
              "columns": 2,
              "iconSize": "lg",
              "iconAlignment": "center",
              "textAlignment": "center",
              "iconColor": "hsl(142 71% 45%)",
              "textColor": "hsl(var(--muted-foreground))",
              "cardBackground": "hsl(var(--card))",
              "sectionBackground": "var(--background)",
              "enableSwipeOnMobile": false,
              "anchor": "the-solution",
              "features": [
                {
                  "id": "df-sol-1",
                  "icon": "WifiOff",
                  "title": "True DDIL-Native Architecture",
                  "description": "Frontbase edge nodes are self-sufficient by design. Local SQLite databases and Redis queues operate indefinitely without network connectivity. If SATCOM is jammed, command capabilities remain fully operational."
                },
                {
                  "id": "df-sol-2",
                  "icon": "RefreshCw",
                  "title": "Asynchronous Intelligence Sync",
                  "description": "Data syncs only when SATCOM windows open. Edge Redis buffers intelligence, logistics, and sensor data with zero loss during communications blackout. Conflict resolution handles concurrent updates across disconnected nodes."
                },
                {
                  "id": "df-sol-3",
                  "icon": "Undo2",
                  "title": "Immutable Mission Packages",
                  "description": "No CrowdStrike-style forced updates. Mission apps are pre-compiled, digitally signed bundles pushed intentionally during maintenance windows. One-click rollback to last known-good version eliminates supply chain update risk."
                },
                {
                  "id": "df-sol-4",
                  "icon": "Lock",
                  "title": "Zero Attack Surface",
                  "description": "Published Frontbase apps are static, server-side rendered bundles. No exploitable runtime API, no credentials in page HTML, no dynamic server-side code to compromise. The attack surface is essentially zero."
                }
              ]
            },
