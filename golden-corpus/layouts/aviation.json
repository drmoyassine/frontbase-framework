          {
            "id": "av-problem-section",
            "type": "FeatureSection",
            "props": {
              "title": "The $2B Problem: Centralized Architecture",
              "subtitle": "Single points of failure consistently ground operations. Same pattern, different year.",
              "headerAlignment": "center",
              "columns": 2,
              "iconSize": "lg",
              "iconAlignment": "left",
              "textAlignment": "left",
              "iconColor": "hsl(0 84% 60%)",
              "textColor": "hsl(var(--muted-foreground))",
              "cardBackground": "hsl(var(--card))",
              "sectionBackground": "var(--background)",
              "enableSwipeOnMobile": false,
              "anchor": "the-problem",
              "features": [
                {
                  "id": "av-prob-1",
                  "icon": "AlertOctagon",
                  "title": "CrowdStrike & Delta (Jul 2024)",
                  "description": "A faulty global update bricked centralized Windows servers. Crew tracking software died. 7,000 flights cancelled, 1.3M passengers affected, ~$500M in losses due to zero system independence."
                },
                {
                  "id": "av-prob-2",
                  "icon": "CloudLightning",
                  "title": "Southwest IT Meltdown (Dec 2022)",
                  "description": "Winter storm overwhelmed a centralized, legacy crew scheduling system ('SkySolver'). The network collapsed because they couldn't physically track pilots. Result: 16,700 cancellations and a $1.1B loss."
                },
                {
                  "id": "av-prob-3",
                  "icon": "DatabaseZap",
                  "title": "FAA NOTAM Failure (Jan 2023)",
                  "description": "Contractor accidentally deleted a file from the central database. The backup was coupled to the primary and corrupted too. Result: The first nationwide ground stop ordered in the US since 9/11."
                },
                {
                  "id": "av-prob-4",
                  "icon": "PowerOff",
                  "title": "British Airways DC (May 2017)",
                  "description": "A power surge at a single data center near Heathrow paralyzed check-in, boarding, and baggage ops simultaneously. Result: 726 flights cancelled, 75,000 passengers stranded due to inadequate edge failover."
                }
              ]
            },
            "styles": {},
            "children": []
          },
          {
            "id": "av-solution-section",
            "type": "FeatureSection",
            "props": {
              "title": "The Edge-Native Antidote",
              "subtitle": "Decentralize risk. Frontbase gives every airport, terminal, and operation center its own autonomous system.",
              "headerAlignment": "center",
              "columns": 2,
              "iconSize": "lg",
              "iconAlignment": "center",
              "textAlignment": "center",
              "iconColor": "hsl(142 71% 45%)",
              "textColor": "hsl(var(--muted-foreground))",
              "cardBackground": "hsl(var(--card))",
              "sectionBackground": "var(--muted)",
              "enableSwipeOnMobile": false,
              "anchor": "the-solution",
              "features": [
                {
                  "id": "av-sol-1",
                  "icon": "WifiOff",
                  "title": "Offline-Capable Autonomy",
                  "description": "Crew scheduling and baggage dashboards run on independent edge nodes with local SQLite databases. If the cloud UI goes down, the local airport terminal stays fully operational."
                },
                {
                  "id": "av-sol-2",
                  "icon": "Undo2",
                  "title": "Immutable Publish Model",
                  "description": "No forced hot-patches. No kernel driver updates. Code and UIs are pre-compiled and pushed statically. If an update fails, a one-click rollback instantly switches network traffic to the last working version."
                },
                {
                  "id": "av-sol-3",
                  "icon": "Database",
                  "title": "Decoupled Data Architecture",
                  "description": "Your database shouldn't be a single point of failure. Frontbase isolates databases per edge node. A corrupted file in Atlanta's database will never impact operations in London."
                },
                {
                  "id": "av-sol-4",
                  "icon": "ListOrdered",
                  "title": "Crisis Queue Buffering",
                  "description": "During network degradation, passenger check-ins and crew assignments don't fail—they buffer. Edge Redis queues absorb the shock and sync data sequentially once connectivity is restored."
                }
              ]
            },
