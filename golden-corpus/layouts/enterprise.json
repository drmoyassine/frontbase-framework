              "anchor": "capabilities",
              "features": [
                {
                  "id": "ent-cap-telemetry",
                  "icon": "Zap",
                  "title": "Ultra-Low Latency Telemetry",
                  "description": "Process incoming sensor data and IoT streams directly at the network edge (sub-50ms). Mission-critical alerts and responses happen in near real-time."
                },
                {
                  "id": "ent-cap-offline",
                  "icon": "WifiOff",
                  "title": "Offline-Capable Edge Autonomy",
                  "description": "Edge nodes and local databases run independently of the central backend, ensuring factory floors and remote sites stay operational during network outages."
                },
                {
                  "id": "ent-cap-byoe",
                  "icon": "Plug",
                  "title": "BYOE Enterprise Integration",
                  "description": "Connect MQTT brokers, TimescaleDB, InfluxDB, proprietary ERP systems, and enterprise identity providers (Okta, Active Directory) without migrating data."
                },
                {
                  "id": "ent-cap-secrets",
                  "icon": "Shield",
                  "title": "Unified Edge Secret Management",
                  "description": "Centrally manage credentials, API keys, and database connection strings — securely injected into edge environments at runtime with zero client exposure."
                },
                {
                  "id": "ent-cap-dashboards",
                  "icon": "LayoutDashboard",
                  "title": "Digital Twin Dashboards",
                  "description": "Use drag-and-drop, data-bound UI builder to create SCADA-like interfaces, asset tracking portals, and digital twins without writing frontend code."
                },
                {
                  "id": "ent-cap-realtime",
                  "icon": "Radio",
                  "title": "Live Telemetry & WebSockets",
                  "description": "Real-time data binding for operator dashboards reflecting live field telemetry, with UI controls to send remote configuration commands to edge devices."
                },
                {
                  "id": "ent-cap-rbac",
                  "icon": "Users",
                  "title": "Multi-Tier RBAC Portals",
                  "description": "Build distinct, secure experiences from the same data — executive analytics dashboards alongside granular diagnostic and control panels for field engineers."
                },
                {
                  "id": "ent-cap-workflows",
                  "icon": "Network",
                  "title": "Visual Remediation Pipelines",
                  "description": "n8n-style workflow engine to detect anomalies (temperature spikes, pressure drops) and trigger instant edge functions — auto-shutdowns, alerts, escalations."
                },
                {
                  "id": "ent-cap-ai",
                  "icon": "Brain",
                  "title": "Predictive Maintenance & AI",
                  "description": "Drop LLM or ML components into visual workflows. Analyze sensor data, flag degradation patterns, auto-generate service tickets in Jira, ServiceNow, or SAP."
                },
                {
                  "id": "ent-cap-legacy",
                  "icon": "ArrowLeftRight",
                  "title": "Legacy Protocol Translation",
                  "description": "Use edge API routes as a secure proxy to bridge MODBUS, OPC-UA, and older on-premise systems with modern cloud infrastructure via clean REST APIs."
                },
                {
                  "id": "ent-cap-deploy",
                  "icon": "Rocket",
                  "title": "One-Click Fleet Deployment",
                  "description": "Click Publish and updated logic, UIs, and workflow schemas are instantly distributed to global CDN edge nodes with zero downtime. No firmware flashing required."
                },
                {
                  "id": "ent-cap-audit",
                  "icon": "FileCheck",
                  "title": "Compliant Versioning & Audit Trails",
