          {
            "id": "sb-problem-section",
            "type": "FeatureSection",
            "props": {
              "title": "The Smart Building's Achilles Heel: Centralized BMS",
              "subtitle": "The BMS controls HVAC, elevators, fire suppression, and access control. When it's centralized, one breach controls everything.",
              "headerAlignment": "center",
              "columns": 3,
              "iconSize": "lg",
              "iconAlignment": "left",
              "textAlignment": "left",
              "iconColor": "hsl(0 84% 60%)",
              "textColor": "hsl(var(--muted-foreground))",
              "cardBackground": "hsl(var(--card))",
              "sectionBackground": "var(--background)",
              "enableSwipeOnMobile": false,
              "anchor": "the-problem",
              "features": [
                {
                  "id": "sb-prob-1",
                  "icon": "Lock",
                  "title": "Johnson Controls — $27M (Sep 2023)",
                  "description": "Dark Angels ransomware hit the building automation giant. Data exfiltrated. The company that manages HVAC, fire, and security for thousands of buildings worldwide lost $27 million in a single quarter from the incident — and exposed the systemic risk of centralized BMS control."
                },
                {
                  "id": "sb-prob-2",
                  "icon": "AlertOctagon",
                  "title": "MGM Resorts — Casino Floors Dark (2023)",
                  "description": "A sophisticated cyberattack shut down slot machines, room keycards, reservation systems, and payment processing across multiple hotel and casino properties simultaneously. Guests locked out. Revenue stopped. One centralized system controlled everything — and everything went down together."
                },
                {
                  "id": "sb-prob-3",
                  "icon": "Thermometer",
                  "title": "Siegeware: Building Control Held Ransom",
                  "description": "A growing threat class where attackers compromise BMS to control physical building systems — disabling HVAC to force server room overheating, locking access control systems, or manipulating fire suppression. Office towers have been evacuated due to targeted HVAC tampering alone."
                }
              ]
            },
            "styles": {},
            "children": []
          },
          {
            "id": "sb-solution-section",
            "type": "FeatureSection",
            "props": {
              "title": "Building-Level Edge Autonomy",
              "subtitle": "Every building runs its own independent edge node. A breach in the management portal doesn't touch the HVAC in Building 7.",
              "headerAlignment": "center",
              "columns": 2,
              "iconSize": "lg",
              "iconAlignment": "center",
              "textAlignment": "center",
              "iconColor": "hsl(142 71% 45%)",
              "textColor": "hsl(var(--muted-foreground))",
              "cardBackground": "hsl(var(--card))",
              "sectionBackground": "var(--muted)",
              "enableSwipeOnMobile": false,
              "anchor": "the-solution",
              "features": [
                {
                  "id": "sb-sol-1",
                  "icon": "Building2",
                  "title": "Per-Building Edge Nodes",
                  "description": "HVAC optimization, occupancy sensing, and energy management dashboards run on independent edge hardware at each building. If the central management portal is compromised, individual buildings continue operating autonomously with full local control."
                },
                {
                  "id": "sb-sol-2",
                  "icon": "Shield",
                  "title": "Siegeware-Proof Isolation",
                  "description": "Each building's edge node has its own isolated SQLite database. Attackers can't pivot from one compromised building to control HVAC, fire, or access systems in other properties. The blast radius is architecturally limited to one building."
                },
                {
                  "id": "sb-sol-3",
                  "icon": "Users",
                  "title": "Tenant-Facing Control Panels",
                  "description": "Build role-based tenant portals with no-code. Tenants manage their own HVAC preferences, lighting, and access — served from local edge, not a centralized cloud portal that can become a single point of failure or attack."
                },
                {
                  "id": "sb-sol-4",
                  "icon": "BarChart3",
                  "title": "Local Energy Analytics",
                  "description": "Run energy consumption analytics, occupancy pattern detection, and cost optimization at the building edge. Data stays local for privacy. Insights are computed in real-time with zero cloud dependency."
                }
              ]
            },
            "styles": {},
            "children": []
