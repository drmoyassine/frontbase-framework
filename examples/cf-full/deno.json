{
    "tasks": {
        "start": "deno run --allow-net --allow-read --allow-env --allow-sys src/deno.ts"
    },
    "deploy": {
        "install": "pnpm install",
        "build": "pnpm -r build",
        "runtime": {
            "type": "dynamic",
            "entrypoint": "./deno-entry.mjs"
        }
    }
}
