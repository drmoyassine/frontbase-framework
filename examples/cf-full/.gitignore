dist/
.wrangler/
node_modules/

# The console artifact is built from the in-repo @frontbase/console package
# (`pnpm console:build`) and verified by `pnpm console:check`. Nothing under
# console-dist/ is tracked except .assetsignore (wrangler's upload exclusion).
console-dist/*
!console-dist/.assetsignore
e2e/report/
e2e/test-results/
test-results/

# Docker compose reads live secrets from .env (SESSION_SECRET, ADMIN_PASSWORD).
# .env.example is the committed template; .env itself never enters git.
.env
