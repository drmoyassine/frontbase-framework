{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "outputDirectory": "console-dist",
    "trailingSlash": false,
    "cleanUrls": false,
    "rewrites": {
        "beforeFiles": [
            { "source": "/frontbase-admin", "destination": "/api/cms" },
            { "source": "/frontbase-admin/index.html", "destination": "/api/cms" }
        ],
        "afterFiles": [
            { "source": "/static/react/:file*", "destination": "/react/:file*" },
            { "source": "/static/icon.png", "destination": "/icon.png" }
        ],
        "fallback": [
            { "source": "/:path*", "destination": "/api/cms" }
        ]
    },
    "headers": [
        {
            "source": "/react/hydrate.js",
            "headers": [
                { "key": "Cache-Control", "value": "no-cache, must-revalidate" },
                { "key": "Content-Type", "value": "application/javascript; charset=utf-8" },
                { "key": "X-Content-Type-Options", "value": "nosniff" }
            ]
        },
        {
            "source": "/react/entry-(.*).css",
            "headers": [
                { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
                { "key": "Content-Type", "value": "text/css; charset=utf-8" }
            ]
        },
        {
            "source": "/icon.png",
            "headers": [
                { "key": "Cache-Control", "value": "public, max-age=86400" },
                { "key": "Content-Type", "value": "image/png" }
            ]
        },
        {
            "source": "/frontbase-admin/assets/(.*)",
            "headers": [
                { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
            ]
        },
        {
            "source": "/frontbase-admin/(.*)",
            "headers": [
                { "key": "Cache-Control", "value": "public, max-age=3600" }
            ]
        }
    ]
}
