{
  "name": "@frontbase/edge-core",
  "version": "0.0.0",
  "description": "The Chimera Engine — unified priority router, eSSR renderer, DataProvider DI, workflow engine, client behaviors runtime, service-worker primitives",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./workflow": {
      "types": "./dist/workflow/index.d.ts",
      "import": "./dist/workflow/index.js"
    },
    "./ssr/components/interactive": {
      "types": "./dist/ssr/components/interactive.d.ts",
      "import": "./dist/ssr/components/interactive.js"
    },
    "./ssr/components/static": {
      "types": "./dist/ssr/components/static.d.ts",
      "import": "./dist/ssr/components/static.js"
    },
    "./ssr/components/data": {
      "types": "./dist/ssr/components/data.d.ts",
      "import": "./dist/ssr/components/data.js"
    },
    "./ssr/components/landing": {
      "types": "./dist/ssr/components/landing/index.d.ts",
      "import": "./dist/ssr/components/landing/index.js"
    },
    "./ssr/baseStyles": {
      "types": "./dist/ssr/baseStyles.d.ts",
      "import": "./dist/ssr/baseStyles.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node test/parity.mjs && node test/wysiwyg-parity.mjs && node test/engine.mjs && node test/scope.mjs && node test/fallback.mjs && node test/behaviors.mjs && node test/workflow.mjs",
    "test:mutation": "node test/mutation.mjs"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "liquidjs": "^10.24.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/react": "18.3.1",
    "@types/react-dom": "18.3.1",
    "lucide-react": "0.462.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}